# Guinevere Hermes Agent — Environment Configuration
# Deploy: Copy to ~/.hermes/.env, fill SOPS-decrypted values
# Permissions: chmod 600 ~/.hermes/.env

# Discord Gateway
DISCORD_BOT_TOKEN=<SOPS:secrets/discord.enc.yaml#bot_token>
DISCORD_ALLOWED_USERS=<faiz-discord-user-id>
DISCORD_ALLOWED_CHANNELS=1510914600777023659
DISCORD_REQUIRE_MENTION=false
DISCORD_FREE_RESPONSE_CHANNELS=1510914600777023659
DISCORD_AUTO_THREAD=false

# LLM Provider (9Router proxy)
NINEROUTER_API_KEY=<SOPS:secrets/ninerouter.enc.yaml#api_key>
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=gpt-5.5
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.7
LLM_BUDGET_MONTHLY=30

# Data Stores
REDIS_URL=redis://localhost:6380/5
DATABASE_URL=postgresql://hermes_app:<SOPS:secrets/postgres.enc.yaml#hermes_app_password>@localhost:5433/guinevere

# Memory
MEMORY_BACKEND=redis

# Session
GROUP_SESSIONS_PER_USER=true

# Observability
PROMETHEUS_METRICS_PORT=9191
LOG_LEVEL=info
LOG_FORMAT=json

# Approval Webhook
DISCORD_APPROVAL_WEBHOOK=<SOPS:secrets/discord.enc.yaml#approval_webhook>

# ── Shadow Mode (separate bot for Hermes shadow testing) ──
# Shadow bot runs in #hermes-shadow channel, compares Hermes responses
# against bot.py responses. NEVER sends Hermes output to production channels.
DISCORD_SHADOW_BOT_TOKEN=<SOPS:secrets/discord-shadow-secrets.yaml#bot_token>
DISCORD_SHADOW_BOT_ID=1512088992764399717
DISCORD_SHADOW_CHANNEL_ID=<shadow-channel-id>
SHADOW_ENABLED=false
SHADOW_TRAFFIC_PCT=0