# Guinevere repository ignore rules
# Keep encrypted secrets only; never track plaintext credentials.

# SOPS-encrypted secrets are allowed
!secrets/
!secrets/*.yaml
!secrets/*.json
!secrets/*.env

# Plaintext env/secrets
.env
.env.*
*.env
*.env.local
*.envrc
*.secret
*.secrets
*.token
*.key
*.pem
id_rsa*
id_ed25519*
*.agekey
age-key.txt

# SOPS temporary / decrypted files
*.dec
*.decrypted
*.plaintext
*.plain
*.tmp
*.bak
*.backup

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

