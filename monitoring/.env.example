# monitoring/.env.example — Template for monitoring stack environment
# Copy to monitoring/.env and fill real values via SOPS decryption.
# DO NOT commit monitoring/.env to git.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_VIA_SOPS

# Postgres exporter — uses guinevere_core read-only role
PG_EXPORTER_PASSWORD=CHANGE_ME_VIA_SOPS

# Redis exporter — uses dedicated exporter ACL user
REDIS_EXPORTER_PASSWORD=CHANGE_ME_VIA_SOPS

# Alertmanager Discord webhook (optional — configured in alertmanager.yml)
DISCORD_WEBHOOK_URL=CHANGE_ME_VIA_SOPS
