    {
      "id": 23,
      "type": "table",
      "title": "Recent Anomalies",
      "description": "Most recent wearable anomalies (limit 50) ordered by time descending.",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALEDB}" },
          "rawSql": "SELECT time AS \"Time\", metric AS \"Metric\", severity AS \"Severity\", value AS \"Value\", threshold AS \"Threshold\" FROM health.anomalies WHERE $__timeFilter(time) ORDER BY time DESC LIMIT 50",
          "format": "table",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Time" },      "properties": [{ "id": "custom.width", "value": 180 }] },
          { "matcher": { "id": "byName", "options": "Metric" },    "properties": [{ "id": "custom.width", "value": 140 }] },
          { "matcher": { "id": "byName", "options": "Severity" },  "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "color", "value": { "mode": "thresholds" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "#16A34A", "value": null },
              { "color": "#CA8A04", "value": 1 },
              { "color": "#DC2626", "value": 2 }
            ] } }
          ] },
          { "matcher": { "id": "byName", "options": "Value" },     "properties": [{ "id": "custom.width", "value": 100 }] },
          { "matcher": { "id": "byName", "options": "Threshold" }, "properties": [{ "id": "custom.width", "value": 100 }] }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Time", "desc": true }],
        "footer": { "show": false }
      },
      "pluginVersion": "10.4.0"
    },
